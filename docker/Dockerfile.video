FROM nvidia/cuda:13.0.0-base-ubuntu22.04

ARG PYTHON_VERSION=3.12
ARG FROM_SOURCE=false
ARG EXTRA_DEPS=""
ARG TORCH_VERSION=2.13.0
ARG TORCHVISION_VERSION=0.28.0
ARG TRANSFORMERS_VERSION=5.19.0
ARG VLLM_VERSION=0.32.0
ARG AQUILES_VERSION=0.8.5

RUN apt-get update && apt-get install -y \
    git curl build-essential libgl1 libglib2.0-0 wget ffmpeg libavcodec-dev libavformat-dev libavutil-dev libswscale-dev libavfilter-dev libavdevice-dev \
    && rm -rf /var/lib/apt/lists/*

RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:${PATH}"

RUN uv python install ${PYTHON_VERSION}
ENV UV_PYTHON=${PYTHON_VERSION}

RUN PYDIR=$(find /root/.local/share/uv/python -maxdepth 1 -type d -name "cpython-*") && \
    ln -s "$PYDIR/bin/aquiles-image" /usr/local/bin/aquiles-image

ENV HF_XET_HIGH_PERFORMANCE=1
ENV PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
ENV UV_BREAK_SYSTEM_PACKAGES=1

WORKDIR /app

RUN uv pip install --system --python ${PYTHON_VERSION} \
    --index-url https://download.pytorch.org/whl/cu130 \
    torch==${TORCH_VERSION} torchvision==${TORCHVISION_VERSION} \
    && rm -rf /root/.cache/uv

# vllm 0.32 needs torch 2.13 and transformers <5.20; the flash-attn wheel targets that same pair.
RUN uv pip install --system --python ${PYTHON_VERSION} \
    transformers==${TRANSFORMERS_VERSION} \
    git+https://github.com/ModelTC/LightX2V.git \
    bitsandbytes accelerate av torchao \
    https://github.com/mjun0812/flash-attention-prebuild-wheels/releases/download/v0.9.47/flash_attn_3-3.0.0+cu130torch2.13gite2743ab-cp39-abi3-linux_x86_64.whl \
    vllm==${VLLM_VERSION} \
    && rm -rf /root/.cache/uv

RUN if [ "$FROM_SOURCE" = "true" ]; then \
        uv pip install --system --python ${PYTHON_VERSION} \
            git+https://github.com/huggingface/diffusers.git \
            git+https://github.com/Aquiles-ai/Aquiles-Image.git \
            && rm -rf /root/.cache/uv; \
    else \
        uv pip install --system --python ${PYTHON_VERSION} diffusers==0.42.1 aquiles-image==${AQUILES_VERSION} \
        && rm -rf /root/.cache/uv; \
    fi

RUN if [ -n "$EXTRA_DEPS" ]; then \
        uv pip install --system --python ${PYTHON_VERSION} $EXTRA_DEPS \
        && rm -rf /root/.cache/uv; \
    fi

COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

VOLUME ["/root/.cache/huggingface", "/root/.local/share"]

ENTRYPOINT ["/entrypoint.sh"]
CMD ["aquiles-image", "serve"]